+def warm_start(model, model_dir, mag):
+    """[littlebit-bench] Continue from a finished LittleBit model. A finished model keeps only the signs of its latent
+    factors (bit-packed) and its scales; the latent values themselves are gone. So each factor restarts as
+    sign * mag. The forward pass uses only signs and scales, so step 0 reproduces the finished model exactly."""
+    from safetensors.torch import load_file
+    from quantization.modules import LittleBitLinear
+    from quantization.utils.binary_packer import binary_unpacker
+
+    sd = {}
+    for f in sorted(Path(model_dir).glob("*.safetensors")):
+        sd.update(load_file(str(f)))
+    params = dict(model.named_parameters())
+    n_signs = n_other = 0
+    for name, mod in model.named_modules():
+        if not isinstance(mod, LittleBitLinear):
+            continue
+        for p in ("U", "V", "U_R", "V_R"):
+            if f"{name}.{p}_packed" in sd:
+                shape = tuple(int(x) for x in sd[f"{name}.{p}_shape"])
+                signs = binary_unpacker(sd[f"{name}.{p}_packed"], shape)
+                getattr(mod, p).data.copy_(signs.to(getattr(mod, p).device, torch.float32) * mag)
+                n_signs += 1
+    for name, t in sd.items():
+        if name in params and params[name].requires_grad:
+            params[name].data.copy_(t.to(params[name].device, params[name].dtype))
+            n_other += 1
+    print(f"INFO: warm start from {model_dir}: {n_signs} sign factors (latent magnitude {mag}), {n_other} other tensors")
+
