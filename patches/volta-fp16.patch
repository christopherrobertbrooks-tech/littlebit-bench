+class PerplexityCallback(TrainerCallback):
+    """[littlebit-bench] A learning curve in perplexity: WikiText-2 test at 2048 tokens, the same windows and loss as
+    eval.py, so the last point matches the final eval. Written to <save_dir>/ppl_curve.jsonl."""
+
+    def __init__(self, tokenizer, every, out_path, seqlen=2048):
+        from utils.datautils import get_wikitext2
+        self.ids = get_wikitext2(tokenizer).input_ids
+        self.every, self.out_path, self.seqlen = every, out_path, seqlen
+
+    @torch.no_grad()
+    def ppl(self, model):
+        was_training = model.training
+        model.eval()
+        device = next(model.parameters()).device
+        n = self.ids.numel() // self.seqlen
+        nll = 0.0
+        for i in range(n):
+            batch = self.ids[:, i * self.seqlen:(i + 1) * self.seqlen].to(device)
+            with torch.autocast("cuda", dtype=torch.float16):
+                logits = model(batch, use_cache=False).logits
+            nll += nn.functional.cross_entropy(logits[0, :-1].float(), batch[0, 1:]).item() * (self.seqlen - 1)
+        if was_training:
+            model.train()
+        return float(torch.exp(torch.tensor(nll / (n * (self.seqlen - 1)))))
+
+    def log_point(self, state, model):
+        p = self.ppl(model)
+        row = {"step": state.global_step, "samples": state.global_step * self.samples_per_step, "wiki_ppl": p}
+        print(f"[ppl-curve] {json.dumps(row)}", flush=True)
+        with open(self.out_path, "a") as f:
+            f.write(json.dumps(row) + "\n")
+
+    def on_train_begin(self, args, state, control, model=None, **kwargs):
+        self.samples_per_step = args.per_device_train_batch_size * args.gradient_accumulation_steps
+        self.log_point(state, model)
+
+    def on_step_end(self, args, state, control, model=None, **kwargs):
+        if state.global_step % self.every == 0 or state.global_step == state.max_steps:
+            self.log_point(state, model)
+
+
