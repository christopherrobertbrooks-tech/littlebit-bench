     ]
+    # [littlebit-bench] mixed bits: --eff_bit_layers "0-7,27:2.0" gives those decoder blocks their own eff_bit
+    # (patch_inst applies the matching entries in order, so these override common_kwargs' eff_bit)
+    for blocks, bits in parse_eff_bit_layers(getattr(args, "eff_bit_layers", None)):
+        convert_kwargs.append(([re.compile(r"\.layers\.(" + "|".join(map(str, blocks)) + r")\.")], {"eff_bit": bits}))
 
