+def parse_eff_bit_layers(spec):
+    """[littlebit-bench] "0-7,27:2.0;12:1.5" -> [([0..7, 27], 2.0), ([12], 1.5)]; None or "" -> []."""
+    out = []
+    for group in (spec or "").split(";"):
+        group = group.strip()
+        if not group:
+            continue
+        blocks_s, bits_s = group.rsplit(":", 1)
+        blocks = []
+        for part in blocks_s.split(","):
+            a, _, b = part.strip().partition("-")
+            blocks += list(range(int(a), int(b) + 1)) if b else [int(a)]
+        out.append((sorted(set(blocks)), float(bits_s)))
+    return out
+
+
 def apply_littlebit_patch(model: nn.Module, args, do_train: bool = False):
